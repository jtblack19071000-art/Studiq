EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat SDK key — safe to embed client-side, unlike the server-only keys below.
# https://www.revenuecat.com/docs/authentication
# Required for the Platinum subscription (recording, AI generation, College Match).
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Server-only (no EXPO_PUBLIC_ prefix — never sent to the client bundle).
# Required for lecture transcription (app/api/transcribe+api.ts).
OPENAI_API_KEY=
# Required for AI-generated study materials (app/api/generate-lecture-materials+api.ts,
# app/api/generate-unit-study-guide+api.ts, app/api/college-match-guidance+api.ts,
# app/api/import-syllabus+api.ts).
ANTHROPIC_API_KEY=
# Service role key from Supabase project settings > API. NEVER expose this to the client — it
# bypasses row-level security. Required for account deletion (app/api/delete-account+api.ts).
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase dashboard settings that affect auth (Authentication > Providers / Templates) ---
# Email OTP-code sign-up/recovery (what AuthForm.tsx expects) requires the email templates for
# "Confirm signup" and "Reset password" to include {{ .Token }} — by default Supabase's templates
# only include a magic-link {{ .ConfirmationURL }}, which this app's code-entry screen can't use.
# Phone sign-up requires an SMS provider (Twilio, MessageBird, etc.) configured under
# Authentication > Providers > Phone — without one, phone sign-up will fail with a clear error.
